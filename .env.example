# Copy this file to server/.env and fill in your own YouTube Data API v3 key.
# Get a key at https://console.cloud.google.com/apis/credentials
# (enable "YouTube Data API v3" on the project first)

YOUTUBE_API_KEY=your_api_key_here
PORT=8787

# Comma-separated list of origins allowed to call this server (your Vite dev URL in dev)
CORS_ORIGIN=http://localhost:5173
